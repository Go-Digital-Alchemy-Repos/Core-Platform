# Copy to .env for local development. Production values should be unique per deployment.

# Stable, non-secret deployment identity. Required by npm run deploy:check.
# Use one unique lowercase kebab-case value per independently deployed client stack.
CLIENT_STACK_ID=local-development

# Required: PostgreSQL connection string used by npm run dev and npm run db:push.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/core_platform

# Required in production. Optional but recommended for stable local sessions.
SESSION_SECRET=dev-secret-change-me

# The dev script defaults to 5001 because port 5000 is commonly used by macOS AirTunes.
PORT=5001

# Current Core Platform service origin used in emails, origin validation, links, and integrations.
# The separate public-site/dashboard origin contract must be approved before a client launch.
APP_URL=http://localhost:5001

# Comma-separated origins allowed to submit browser requests. Required by the client production preflight.
# A separately hosted public React site must be listed here when it calls the API from a browser.
TRUSTED_ORIGINS=http://localhost:5001

# Optional one-time token for initial admin setup via /setup.
# SETUP_TOKEN=
# VITE_SETUP_TOKEN_REQUIRED=

# Optional observability.
LOG_LEVEL=info
METRICS_ENABLED=false

# Optional SMTP email delivery. If omitted, email sending is logged/skipped in dev paths.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Core Platform <noreply@example.com>"

# Optional Stripe payments/subscriptions. These can also be configured in Admin > Settings.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional CMS preview token override. Falls back to SESSION_SECRET when omitted.
# CMS_PREVIEW_SECRET=

# Optional system backups to Cloudflare R2.
SYSTEM_BACKUPS_ENABLED=false
SYSTEM_BACKUP_INTERVAL_HOURS=24
SYSTEM_BACKUP_RETENTION_DAYS=30
SYSTEM_BACKUP_MAX_SNAPSHOTS=30
SYSTEM_BACKUP_EXCLUDED_TABLES=session,__drizzle_migrations
# BACKUP_R2_ACCOUNT_ID=
# BACKUP_R2_ACCESS_KEY_ID=
# BACKUP_R2_SECRET_ACCESS_KEY=
# BACKUP_R2_BUCKET_NAME=
# BACKUP_R2_PREFIX=core-platform

# Optional feature/demo helpers.
# BACKGROUND_CHECK_VENDOR=manual
# DIRECTORY_DEMO_MODE=
# DASHBOARD_ANALYTICS_CACHE_TTL=
# FILTER_OPTIONS_CACHE_TTL=
